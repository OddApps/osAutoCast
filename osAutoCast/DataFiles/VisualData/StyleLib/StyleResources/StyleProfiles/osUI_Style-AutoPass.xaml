<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:osCtrl="clr-namespace:osAutoCast.osControls" xmlns:ospreflib="clr-namespace:ospreflib"
                    mc:Ignorable="d" xmlns:osStyle="clr-namespace:osAutoCast.osStyle">

    <Style x:Key="osAutoPassContainerStyle" TargetType="{x:Type osCtrl:osBorder}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="#FF101010" />
        <Setter Property="Background" Value="#FF3C3C3C" />
        <Setter Property="BorderThickness" Value="4,4,4,4" />
        <Setter Property="CornerRadius" Value="4,4,14,14" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="ClipInflation" Value="1" />
    </Style>

    <Style x:Key="osAutoPassContentContainerStyle" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Background" Value="#FF9E9E9E" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="osAutoPassContentLayoutStyle" TargetType="{x:Type Grid}">
        <Setter Property="osStyle:osContainerLayout.Rows" Value="*,28" />
        <Setter Property="osStyle:osContainerLayout.SeparatorBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00000000" Offset="0.0" />
                    <GradientStop Color="#FF060606" Offset="0.2" />
                    <GradientStop Color="#FF060606" Offset="0.8" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="osStyle:osContainerLayout.SeparatorThickness" Value="2" />
    </Style>

    <Style x:Key="osAutoPassTitleStyle" TargetType="{x:Type Label}">
        <Setter Property="FontFamily" Value="Trebuchet MS"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextBlock.LineHeight" Value="22"/>
    </Style>

    <Style x:Key="osAutoPassProgressStyle" TargetType="{x:Type osCtrl:osProgressBar}">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Progress" Value="0"/>
        <Setter Property="IsAutoPass" Value="True"/>
        <Setter Property="TrackBrush" Value="#FF393939"/>
        <Setter Property="BorderBrush" Value="#FF060606"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="CacheMode" Value="BitmapCache"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="LowQuality"/>
    </Style>
    
</ResourceDictionary>
