<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:oseffect="clr-namespace:osAutoCast.osEffectConv"
                    xmlns:osStyle="clr-namespace:osAutoCast.osStyle"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:gamemenuopts="clr-namespace:osAutoCast.GameMenuOpts"
                    xmlns:local="clr-namespace:osAutoCast">

    <oseffect:TexelSizeConverter x:Key="TexelSizeConverter" />

    <Style x:Key="TrayMenuContainerOutlineStyle" TargetType="{x:Type Grid}">
        <Setter Property="Background" Value="{StaticResource osTrayMenu_BG}" />
        <Setter Property="Width" Value="196" />
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransformOrigin" Value="1,1"/>
    </Style>

    <Style x:Key="TrayMenuContentContainerStyle" TargetType="{x:Type Grid}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="184" />
        <Setter Property="osStyle:osContainerLayout.Rows" Value="auto,auto,auto,auto" />
        <Setter Property="osStyle:osContainerLayout.SeparatorBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00000000" Offset="0.0"/>
                    <GradientStop Color="#A1060606" Offset="0.3"/>
                    <GradientStop Color="#A1060606" Offset="0.7"/>
                    <GradientStop Color="#00000000" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="osStyle:osContainerLayout.SeparatorThickness" Value="1"/>
    </Style>

    <Style x:Key="TrayMenuStyle" TargetType="{x:Type Window}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Style.Resources>
            <Storyboard x:Key="TrayMenuVis_Display">
                <DoubleAnimation Storyboard.TargetName="RootScale"
                                 Storyboard.TargetProperty="ScaleX"
                                 From="0" To="1" Duration="0:0:0.475"
                                 FillBehavior="HoldEnd">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="RootScale" 
                                 Storyboard.TargetProperty="ScaleY"
                                 From="0" To="1" FillBehavior="HoldEnd"
                                 Duration="0:0:0.475">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="TrayMenuOutline" 
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.475"
                                 FillBehavior="HoldEnd">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="TrayMenuVis_Close">
                <DoubleAnimation Storyboard.TargetName="RootScale" 
                                 Storyboard.TargetProperty="ScaleX"
                                 From="1" To="0" Duration="0:0:0.475"
                                 FillBehavior="HoldEnd">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="RootScale" 
                                 Storyboard.TargetProperty="ScaleY"
                                 From="1" To="0" Duration="0:0:0.475"
                                 FillBehavior="HoldEnd">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="TrayMenuOutline" 
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.475"
                                 FillBehavior="HoldEnd">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

        </Style.Resources>
    </Style>

    <Style x:Key="TrayMenuContainerBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="#FF222222" />
        <Setter Property="Background" Value="{StaticResource osTrayMenu_BG}" />
        <Setter Property="BorderThickness" Value="6" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Width" Value="196" />
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="TrayMenuItemStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#FF8f8f8f"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="osStyle:osStyles.BorderBrush" Value="#FF2B2828"/>
        <Setter Property="osStyle:osStyles.Background" Value="#FF575757"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate  DataType="{x:Type sys:String}">
                    <TextBlock x:Name="traymenuContent" Text="{Binding}" Padding="0,3"
                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                               TextAlignment="Center" FontSize="18" FontWeight="Bold"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                               local:TextBlockExtensions.CharacterSpacing="1.20">
                        <TextBlock.Effect>
                            <local:osEffectManager x:Name="traymenuGlow" Thickness="{StaticResource osTrayMenuEffect_Thickness}"
                                                   Spread="{StaticResource osTrayMenuEffect_Spread}" Fade="{StaticResource osTrayMenuEffect_Fade}"
                                                   GlowColor="{StaticResource osTrayMenuEffect_Color}" StrokeStrength="{StaticResource osTrayMenuEffect_Stroke}"
                                                   GlowStrength="{StaticResource osTrayMenuEffect_Glow}">
                                <local:osEffectManager.TexelSize>
                                    <MultiBinding Converter="{StaticResource TexelSizeConverter}">
                                        <Binding ElementName="traymenuContent" Path="ActualWidth"/>
                                        <Binding ElementName="traymenuContent" Path="ActualHeight"/>
                                    </MultiBinding>
                                </local:osEffectManager.TexelSize>
                            </local:osEffectManager>
                        </TextBlock.Effect>
                    </TextBlock>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="traymenuGlow"
                                             Storyboard.TargetProperty="Fade"
                                             To="1" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="traymenuGlow"
                                             Storyboard.TargetProperty="Fade"
                                             To="0" Duration="0:0:0.35"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
       <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="TrayMenuItemBorder" Background="{TemplateBinding Background}" Height="30"
                            CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.CornerRadius)}"
                            BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.BorderThickness)}"
                            BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.BorderBrush)}">
                        <ContentPresenter x:Name="TrayMenuItem" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="TrayMenuItemBorder"
                                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.Background)}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayMenuItemDefaultStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource TrayMenuItemStyle}">
        <Setter Property="osStyle:osStyles.CornerRadius" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderThickness" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderBrush" Value="#FF222222"/>
        <Setter Property="osStyle:osStyles.Background" Value="#FF575757"/>
    </Style>

    <Style x:Key="GameTrayMenu_ShowStart" TargetType="{x:Type Button}"
           BasedOn="{StaticResource TrayMenuItemDefaultStyle}">
        <Setter Property="osStyle:osStyles.CornerRadius" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderThickness" Value="0,2,0,0"/>
        <Setter Property="osStyle:osStyles.BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00000000" Offset="0.0"/>
                    <GradientStop Color="#F1AAAAAA" Offset="0.3"/>
                    <GradientStop Color="#F1AAAAAA" Offset="0.7"/>
                    <GradientStop Color="#00000000" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="osStyle:osStyles.Background" Value="#FF363636"/>
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DisplayGameTrayMenuItem}"
                         Value="{x:Static gamemenuopts:GameMenuItem.ShowStart}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GameTrayMenu_ShowClose" TargetType="{x:Type Button}"
           BasedOn="{StaticResource TrayMenuItemDefaultStyle}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="osStyle:osStyles.CornerRadius" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderThickness" Value="0,2,0,0"/>
        <Setter Property="osStyle:osStyles.BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00000000" Offset="0.0"/>
                    <GradientStop Color="#F1AAAAAA" Offset="0.3"/>
                    <GradientStop Color="#F1AAAAAA" Offset="0.7"/>
                    <GradientStop Color="#00000000" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="osStyle:osStyles.Background" Value="#C4363636"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DisplayGameTrayMenuItem}"
                         Value="{x:Static gamemenuopts:GameMenuItem.ShowClose}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TrayMenuItemBorderStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource TrayMenuItemStyle}">
        <Setter Property="osStyle:osStyles.BorderThickness" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.CornerRadius" Value="0,0,5,5"/>
        <Setter Property="osStyle:osStyles.BorderBrush" Value="#FF222222"/>
        <Setter Property="osStyle:osStyles.Background" Value="#FF575757"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="TrayMenuItemBorder" Background="{TemplateBinding Background}"
                            CornerRadius="0,0,2,2"
                            BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.BorderThickness)}"
                            BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.BorderBrush)}">
                        <ContentPresenter x:Name="TrayMenuItem" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="TrayMenuItemBorder"
                                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.Background)}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayMenuItemGameStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource TrayMenuItemStyle}">
        <Setter Property="Background" Value="#A1101010" />
        <Setter Property="osStyle:osStyles.CornerRadius" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderThickness" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderBrush" Value="#FF222222"/>
        <Setter Property="osStyle:osStyles.Background" Value="#FF575757"/>
    </Style>

    <Style x:Key="TrayMenuItemToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#FF8f8f8f"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="osStyle:osStyles.BorderBrush" Value="#FF2B2828"/>
        <Setter Property="osStyle:osStyles.Background" Value="#FF575757"/>
        <Setter Property="osStyle:osStyles.DefaultBackground" Value="#FF363636"/>
    </Style>

    <Style x:Key="TrayMenuItemEnDisStyle" BasedOn="{StaticResource TrayMenuItemToggleStyle}" TargetType="{x:Type ToggleButton}">
        <Setter Property="osStyle:osStyles.BorderThickness" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.CornerRadius" Value="5,5,0,0"/>
        <Setter Property="IsChecked" Value="{Binding osEnabledStatus, Source={StaticResource osEnabledStatusConfig}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type sys:String}">
                    <TextBlock x:Name="traymenuToggleContent" Text="{Binding}" Padding="0,3"
                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                               TextAlignment="Center" FontSize="18" FontWeight="Bold"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"
                               local:TextBlockExtensions.CharacterSpacing="1.20">
                        <TextBlock.Effect>
                            <local:osEffectManager x:Name="traymenuToggleGlow" Thickness="{StaticResource osTrayMenuEffect_Thickness}"
                                                   Spread="{StaticResource osTrayMenuEffect_Spread}" Fade="{StaticResource osTrayMenuEffect_Fade}"
                                                   GlowColor="{StaticResource osTrayMenuEffect_Color}" StrokeStrength="{StaticResource osTrayMenuEffect_Stroke}"
                                                   GlowStrength="{StaticResource osTrayMenuEffect_Glow}">
                                <local:osEffectManager.TexelSize>
                                    <MultiBinding Converter="{StaticResource TexelSizeConverter}">
                                        <Binding ElementName="traymenuToggleContent" Path="ActualWidth"/>
                                        <Binding ElementName="traymenuToggleContent" Path="ActualHeight"/>
                                    </MultiBinding>
                                </local:osEffectManager.TexelSize>
                            </local:osEffectManager>
                        </TextBlock.Effect>
                    </TextBlock>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="traymenuToggleGlow"
                                             Storyboard.TargetProperty="Fade"
                                             To="1" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="traymenuToggleGlow"
                                             Storyboard.TargetProperty="Fade"
                                             To="0" Duration="0:0:0.35"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}" >
                    <Border x:Name="TrayMenuItemToggleBorderEn" CornerRadius="2,2,0,0" Width="{TemplateBinding Width}" 
                            Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.DefaultBackground)}"                           
                            BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.BorderThickness)}"
                            BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.BorderBrush)}">
                        <ContentPresenter x:Name="TrayMenuItemToggleContentEn" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" Margin="0"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TrayMenuItemToggleBorderEn" Property="Background"
                                    Value="#FF575757" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter TargetName="TrayMenuItemToggleBorderEn" Property="Background"
                                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.DefaultBackground)}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">                            
                            <Setter Property="Content" Value="Disabled" />
                            <Setter TargetName="TrayMenuItemToggleBorderEn" Property="Background" Value="#FF0F0F0F" />
                            <Setter Property="Foreground" Value="#FF373636" />
                            <Setter TargetName="TrayMenuItemToggleContentEn" Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="4" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Content" Value="Enabled" />
                            <Setter Property="Foreground" Value="#FF8C8A8A" />
                            <Setter TargetName="TrayMenuItemToggleBorderEn" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TrayMenuItemToggleBorderEn" Property="Background"
                                    Value="#FF575757" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="True" />
                            <Condition Property="IsMouseOver" Value="False" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="TrayMenuItemToggleBorderEn" Property="Background"
                                Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.DefaultBackground)}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TrayMenuItemToggleBorderEn" Property="Background"
                                    Value="#FF575757" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Content" Value="Disabled" />
                            <Setter TargetName="TrayMenuItemToggleBorderEn" Property="Background" Value="#FF0F0F0F" />
                            <Setter Property="Foreground" Value="#FF373636" />
                            <Setter TargetName="TrayMenuItemToggleContentEn" Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="4" />
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayMenuItemGameMenuStyle" BasedOn="{StaticResource TrayMenuItemToggleStyle}" TargetType="{x:Type ToggleButton}">
        <Setter Property="osStyle:osStyles.CornerRadius" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderThickness" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderBrush" Value="#FF222222"/>
        <Setter Property="osStyle:osStyles.Background" Value="#FF575757"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate  DataType="{x:Type sys:String}">
                    <TextBlock x:Name="traymenuContent" Text="{Binding}" Padding="0,3"
                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                               TextAlignment="Center" FontSize="18" FontWeight="Bold"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"
                               local:TextBlockExtensions.CharacterSpacing="1.20">
                        <TextBlock.Effect>
                            <local:osEffectManager x:Name="traymenuGlow" Thickness="{StaticResource osTrayMenuEffect_Thickness}"
                                                   Spread="{StaticResource osTrayMenuEffect_Spread}" Fade="{StaticResource osTrayMenuEffect_Fade}"
                                                   GlowColor="{StaticResource osTrayMenuEffect_Color}" StrokeStrength="{StaticResource osTrayMenuEffect_Stroke}"
                                                   GlowStrength="{StaticResource osTrayMenuEffect_Glow}">
                                <local:osEffectManager.TexelSize>
                                    <MultiBinding Converter="{StaticResource TexelSizeConverter}">
                                        <Binding ElementName="traymenuContent" Path="ActualWidth"/>
                                        <Binding ElementName="traymenuContent" Path="ActualHeight"/>
                                    </MultiBinding>
                                </local:osEffectManager.TexelSize>
                            </local:osEffectManager>
                        </TextBlock.Effect>
                    </TextBlock>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="traymenuGlow"
                                             Storyboard.TargetProperty="Fade"
                                             To="1" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="traymenuGlow"
                                             Storyboard.TargetProperty="Fade"
                                             To="0" Duration="0:0:0.35"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="gmTrayView_Border" Background="{TemplateBinding Background}"
                            CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.CornerRadius)}"
                            BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.BorderThickness)}"
                            BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.BorderBrush)}">
                        <ContentPresenter x:Name="mnuGameContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="gmTrayView_Border"
                                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.Background)}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HideShowGameTrayMenu" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,0" />
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Height" Value="0" />
        <Setter Property="MaxHeight" Value="30" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="ClipToBounds" Value="True" />   
    </Style>

</ResourceDictionary>
