<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:osEffects="clr-namespace:osAutoCast.osEffectManager"
                    xmlns:osCtrl="clr-namespace:osAutoCast.osControls"
                    xmlns:osStyle="clr-namespace:osAutoCast.osStyle">
    

    <Style TargetType="{x:Type osCtrl:osUpDownTextBox}">
        <Setter Property="BorderBrush" Value="#571F1F1F" />
        <Setter Property="Background" Value="#FF575757" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,0,22,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type osCtrl:osUpDownTextBox}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          BorderThickness="0" Margin="0" />
                            <Grid Width="18" HorizontalAlignment="Right"
                                  Background="#EEE">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <RepeatButton x:Name="osTxtUD_Inc" Grid.Row="0" UseLayoutRounding="True"
                                              Content="▲" Background="#FFa1a1a1" BorderThickness="0"
                                              Style="{StaticResource UpDownRepeatButtonStyle}"
                                              FontSize="9" Focusable="False" IsTabStop="False"
                                              Command="{x:Static osCtrl:osUpDownTextBoxCmds.Increase}" />
                                <RepeatButton x:Name="osTxtUD_Dec" Grid.Row="1" UseLayoutRounding="True"
                                              Content="▼" Background="#FFa1a1a1" BorderThickness="0"
                                              FontSize="9" Focusable="False" IsTabStop="False"
                                              Style="{StaticResource UpDownRepeatButtonStyle}"
                                              Command="{x:Static osCtrl:osUpDownTextBoxCmds.Decrease}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <!--<ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="osTxtUD_Inc" Property="Background"
                                    Value="#3A3A3A" />
                            <Setter TargetName="osTxtUD_Dec" Property="Background"
                                    Value="#3A3A3A" />
                        </Trigger>
                    </ControlTemplate.Triggers>-->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="osPrefsVisQ_DropDownStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="#FF575757" />
        <Setter Property="BorderBrush" Value="#555" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="MainBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="3"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ContentPresenter x:Name="ContentSite" Margin="6,2,25,2"  
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <ToggleButton x:Name="osDropDownButton" Width="18" FontSize="10" Padding="0,2,0,0" Background="#FFa1a1a1"
                                              HorizontalAlignment="Right" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False" ClickMode="Release" Content="▼" Style="{StaticResource VisQDropDownBtnStyle}" />
                            </Grid>
                        </Border>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Width="{Binding ActualWidth, ElementName=MainBorder}" PopupAnimation="None"
                               AllowsTransparency="True" Focusable="False">
                            <Border x:Name="PopupBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    Opacity="0" RenderTransformOrigin="0.5,0">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="-6" />
                                </Border.RenderTransform>
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="MainBorder" Property="Background"
                                    Value="#444" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PopupBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PopupBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         From="-6" To="0" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PopupBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" BeginTime="0:0:0.12" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PopupBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         From="0" To="-6" BeginTime="0:0:0.12" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type osCtrl:osPrefHeader}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{Binding HeaderColor, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type osCtrl:osPrefHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.Effect>
                            <DropShadowEffect ShadowDepth="2" Direction="270" Color="#FF000000" Opacity="0.45" BlurRadius="4" />
                        </Grid.Effect>
                        <Rectangle Grid.Column="0"  Height="{TemplateBinding LineThickness}" 
                                   VerticalAlignment="Center" Margin="0 6 0 0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0.85" />
                                    <GradientStop Color="#FF575757"
                                                  Offset="0" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Header Text -->
                        <TextBlock Grid.Column="1" Text="{TemplateBinding Text}" VerticalAlignment="Center" FontFamily="Segoe UI"
                                   TextOptions.TextRenderingMode="ClearType" FontSize="{TemplateBinding FontSize}" 
                                   Foreground="{TemplateBinding Foreground}" />
                        <Rectangle Grid.Column="3" Height="{TemplateBinding LineThickness}" 
                                   HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0 6 0 0">
              
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="#FF575757"
                                                  Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type osCtrl:osPanel}">
        <Setter Property="HeaderColor" Value="#FFC4C4C4" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type osCtrl:osPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="4" />
                        </Grid.RowDefinitions>
                        <osCtrl:osPrefHeader Text="{TemplateBinding HeaderText}" FontSize="18"
                                              Grid.Row="0" Grid.ColumnSpan="2" Grid.Column="0"
                                              Foreground="#FFC4C4C4" LineBrush="#FF575757"
                                              LineThickness="3" Margin="0,0,0,2"
                                              LineSpacing="10" />
                        <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}" />
                        <!--<Rectangle Grid.Row="2" Height="2" Margin="0 0 0 0" Fill="#FF676767"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Center" />-->

                        <Rectangle Grid.Row="2" Height="3" Margin="0 0 0 0"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Center" >
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#003C3C3C" Offset="0.0" />
                                    <GradientStop Color="#737373" Offset="0.05" />
                                    <GradientStop Color="#737373" Offset="0.95" />
                                    <GradientStop Color="#003C3C3C" Offset="1.0" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>