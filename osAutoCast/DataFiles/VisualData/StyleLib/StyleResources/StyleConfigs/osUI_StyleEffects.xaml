<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:oseffect="clr-namespace:osAutoCast.osEffectConv"
                    xmlns:osStyle="clr-namespace:osAutoCast.osStyle"
                    xmlns:local="clr-namespace:osAutoCast">
    
    <oseffect:TexelSizeConverter x:Key="TexelSizeConverter" />

    <DataTemplate x:Key="osEffectText" DataType="{x:Type sys:String}">
        <TextBlock x:Name="btnContent" Text="{Binding}" Padding="{StaticResource osBtn_TextPadding}"                     
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" SnapsToDevicePixels="True"
                   LineStackingStrategy="BlockLineHeight" FontSize="{StaticResource osBtn_FontSize}" 
                   LineHeight="{StaticResource osBtn_FontSize}" FontWeight="{StaticResource osBtn_FontWeight}" 
                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
            <TextBlock.Effect>
                <local:osEffectManager x:Name="btnGlow" Thickness="{StaticResource osEffect_Thickness}" Spread="{StaticResource osEffect_Spread}"
                                Fade="{StaticResource osEffect_Fade}" GlowColor="{StaticResource osEffect_Color}"
                                StrokeStrength="{StaticResource osEffect_Stroke}" GlowStrength="{StaticResource osEffect_Glow}">
                    <local:osEffectManager.TexelSize>
                        <MultiBinding Converter="{StaticResource TexelSizeConverter}">
                            <Binding ElementName="btnContent" Path="ActualWidth"/>
                            <Binding ElementName="btnContent" Path="ActualHeight"/>
                        </MultiBinding>
                    </local:osEffectManager.TexelSize>
                </local:osEffectManager>
            </TextBlock.Effect>
        </TextBlock>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <DataTrigger.EnterActions>                    
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="btnGlow"
                                             Storyboard.TargetProperty="Fade"
                                             To="1" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="btnGlow"
                                             Storyboard.TargetProperty="Fade"
                                             To="0" Duration="0:0:0.35"/>                            
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="osEffectTextToggle" DataType="{x:Type sys:String}">
        <TextBlock x:Name="toggleTxtContent" Text="{Binding}" Padding="{StaticResource osBtn_TextPadding}"                  
                   SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center"                   
                   TextAlignment="Center"
                   LineStackingStrategy="BlockLineHeight" LineHeight="{StaticResource osBtn_FontSize}"
                   FontWeight="{StaticResource osBtn_FontWeight}" FontSize="{StaticResource osBtn_FontSize}"
                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}">
            <TextBlock.Effect>
                <local:osEffectManager x:Name="toggleGlow" Thickness="{StaticResource osEffect_Thickness}" Spread="{StaticResource osEffect_Spread}"
                                Fade="{StaticResource osEffect_Fade}" GlowColor="{StaticResource osEffect_Color}"
                                StrokeStrength="{StaticResource osEffect_Stroke}" GlowStrength="{StaticResource osEffect_Glow}">
                    <local:osEffectManager.TexelSize>
                        <MultiBinding Converter="{StaticResource TexelSizeConverter}">
                            <Binding ElementName="toggleTxtContent" Path="ActualWidth"/>
                            <Binding ElementName="toggleTxtContent" Path="ActualHeight"/>
                        </MultiBinding>
                    </local:osEffectManager.TexelSize>
                </local:osEffectManager>
            </TextBlock.Effect>
        </TextBlock>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="toggleGlow"
                                             Storyboard.TargetProperty="Fade"
                                             To="1" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="toggleGlow"
                                             Storyboard.TargetProperty="Fade"
                                             To="0" Duration="0:0:0.35"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
