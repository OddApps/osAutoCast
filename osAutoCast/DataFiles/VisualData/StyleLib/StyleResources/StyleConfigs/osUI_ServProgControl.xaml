<UserControl x:Class="osControls.osLoadSpinner" x:Name="osCtrl_LoadSpinner" UseLayoutRounding="True" SnapsToDevicePixels="True"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 Width="{Binding SpinnerSize, ElementName=osCtrl_LoadSpinner}" Height="{Binding SpinnerSize, ElementName=osCtrl_LoadSpinner}">
	
	<UserControl.Resources>
		<Storyboard x:Key="osLoadVis_Complete">	
			<DoubleAnimationUsingKeyFrames Storyboard.TargetName="SpinnerScale"
										   Storyboard.TargetProperty="ScaleX">
				<EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
				<EasingDoubleKeyFrame KeyTime="0:0:0.1925" Value="1.151">
					<EasingDoubleKeyFrame.EasingFunction>
						<BackEase Amplitude="0.57" EasingMode="EaseOut"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
				<EasingDoubleKeyFrame KeyTime="0:0:0.385" Value="1" />
			</DoubleAnimationUsingKeyFrames>
			<DoubleAnimationUsingKeyFrames Storyboard.TargetName="SpinnerScale"
										   Storyboard.TargetProperty="ScaleY">
				<EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
				<EasingDoubleKeyFrame KeyTime="0:0:0.1925" Value="1.151">
					<EasingDoubleKeyFrame.EasingFunction>
						<BackEase Amplitude="0.57" EasingMode="EaseOut"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
				<EasingDoubleKeyFrame KeyTime="0:0:0.385" Value="1" />
			</DoubleAnimationUsingKeyFrames>
		</Storyboard>
	</UserControl.Resources>
	
	<Grid>
		<Viewbox Stretch="Uniform">
			<Canvas x:Name="SpinnerRoot" Width="100" Height="100"
					RenderTransformOrigin="0.5,0.5">
				<Canvas.RenderTransform>
					<TransformGroup>
						<RotateTransform x:Name="SpinnerRotate" Angle="0" />
                        <ScaleTransform x:Name="SpinnerScale" ScaleX="1" ScaleY="1" />
					</TransformGroup>
				</Canvas.RenderTransform>
				<Ellipse x:Name="ProgressTrack" Canvas.Left="0" Canvas.Top="0" Fill="Transparent"
						 Width="100" Height="100" Stroke="#383838" CacheMode="BitmapCache"
						 StrokeThickness="{Binding StrokeThickness, ElementName=osCtrl_LoadSpinner, FallbackValue=18}" />
                <Path x:Name="ProgressPath" Canvas.Left="0" Canvas.Top="0"
					  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                      Stroke="{Binding SpinnerBrush, ElementName=osCtrl_LoadSpinner, FallbackValue=#FFA10000}"
                      StrokeThickness="{Binding StrokeThickness, ElementName=osCtrl_LoadSpinner, FallbackValue=18}" />
            </Canvas>
        </Viewbox>
    </Grid>
	
</UserControl>