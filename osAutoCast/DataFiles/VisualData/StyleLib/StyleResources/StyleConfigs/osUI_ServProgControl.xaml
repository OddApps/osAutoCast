<UserControl x:Class="osControls.osLoadSpinner" x:Name="osCtrl_LoadSpinner" UseLayoutRounding="True" SnapsToDevicePixels="True"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 Width="{Binding SpinnerSize, ElementName=osCtrl_LoadSpinner}" Height="{Binding SpinnerSize, ElementName=osCtrl_LoadSpinner}">
	
	<UserControl.Resources>
		 <Storyboard x:Key="osLoadSpinVis_Complete" FillBehavior="Stop">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ProgressScale"
										   Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                <EasingDoubleKeyFrame KeyTime="00:00:0.08" Value="1.2">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:0.36" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase Exponent="0.57" EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ProgressScale"
                                           Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                <EasingDoubleKeyFrame KeyTime="00:00:0.08" Value="1.2">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:0.36" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase Exponent="0.57" EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

			    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ProgressTrackScale"
                                           Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                <EasingDoubleKeyFrame KeyTime="00:00:0.08" Value="1.2">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:0.36" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase Exponent="0.57" EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ProgressTrackScale"
                                           Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                <EasingDoubleKeyFrame KeyTime="00:00:0.08" Value="1.2">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:0.36" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase Exponent="0.57" EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SpinnerScale"
                                           Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                <EasingDoubleKeyFrame KeyTime="00:00:0.08" Value="1.05">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:0.36" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase Exponent="0.57" EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SpinnerScale"
                                           Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                <EasingDoubleKeyFrame KeyTime="00:00:0.08" Value="1.05">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:0.36" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase Exponent="0.57" EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
	</UserControl.Resources>
	
	<Grid>
		<Viewbox Stretch="Uniform">
			<Canvas x:Name="SpinnerRoot" Width="100" Height="100"					
					RenderTransformOrigin="0.5,0.5">
				<Canvas.RenderTransform>
					<TransformGroup>
						<RotateTransform x:Name="SpinnerRotate" Angle="0" />
                        <ScaleTransform x:Name="SpinnerScale" ScaleX="1" ScaleY="1" />
					</TransformGroup>
				</Canvas.RenderTransform>
				<Ellipse x:Name="ProgressTrack" Canvas.Left="0" Canvas.Top="0" Fill="Transparent"
						 Width="100" Height="100" Stroke="#383838" CacheMode="BitmapCache" 
						 RenderOptions.BitmapScalingMode="LowQuality" RenderOptions.EdgeMode="Aliased"
						 HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
						 StrokeThickness="{Binding StrokeThickness, ElementName=osCtrl_LoadSpinner, FallbackValue=18}">
					<Ellipse.RenderTransform>
                <ScaleTransform x:Name="ProgressTrackScale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
				</Ellipse>
                <Path x:Name="ProgressPath" Canvas.Left="0" Canvas.Top="0"
					  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
					  HorizontalAlignment="Center" VerticalAlignment="Center" CacheMode="BitmapCache"
					  RenderOptions.BitmapScalingMode="LowQuality" RenderTransformOrigin="0.5,0.5"
                      Stroke="{Binding SpinnerBrush, ElementName=osCtrl_LoadSpinner, FallbackValue=#FFA10000}"
                      StrokeThickness="{Binding StrokeThickness, ElementName=osCtrl_LoadSpinner, FallbackValue=18}">
					            <Path.RenderTransform>
                <ScaleTransform x:Name="ProgressScale" ScaleX="1" ScaleY="1"/>
            </Path.RenderTransform>

				</Path>
            </Canvas>
        </Viewbox>
    </Grid>
	
</UserControl>