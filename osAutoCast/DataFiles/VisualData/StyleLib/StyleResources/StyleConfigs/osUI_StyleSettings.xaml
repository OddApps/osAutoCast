<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:osAutoCast"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:VisSettings="clr-namespace:osAutoCast.osVisConfigSettings"
                    xmlns:oscolor="clr-namespace:System.Windows.Media;assembly=PresentationCore">

    <local:osEnabledStatusConfig x:Key="osEnabledStatusConfig"/>
    
    <!-- ** Load Screen Settings ** -->

    <oscolor:SolidColorBrush x:Key="osLoadScreen_BG" Color="#FF100D0B" />
    <oscolor:SolidColorBrush x:Key="osLoadScreen_Border" Color="#FF380000" />
    <oscolor:SolidColorBrush x:Key="osLoadScreen_Transparent" Color="Transparent" />

    <oscolor:Color x:Key="osLoadScreen_LoadTextColor">#FFC0C0C0</oscolor:Color>

    <oscolor:SolidColorBrush x:Key="osLoadScreen_ProgressFill" Color="#FF5F1212" />
    <oscolor:SolidColorBrush x:Key="osLoadScreen_ProgressTrack" Color="#A1242424" />

    <oscolor:SolidColorBrush x:Key="osLoadScreen_ContentBG" Color="#42323232" />
    <oscolor:SolidColorBrush x:Key="osLoadScreen_ContentBorder" Color="#66323232" />

    <!-- ** Tray Menu Settings ** -->

    <oscolor:SolidColorBrush x:Key="osTrayMenu_BG" Color="#FF363636" />

    <sys:Double x:Key="osTrayMenuBtn_Height">32</sys:Double>

    <sys:Double x:Key="osTrayMenuEffect_Glow">0.5</sys:Double>
    <sys:Double x:Key="osTrayMenuEffect_Thickness">1.2</sys:Double>
    <sys:Double x:Key="osTrayMenuEffect_Spread">4</sys:Double>
    <sys:Double x:Key="osTrayMenuEffect_Fade">0</sys:Double>
    <sys:Double x:Key="osTrayMenuEffect_Stroke">1</sys:Double>

    <oscolor:Color x:Key="osTrayMenuEffect_Color">#A1060606</oscolor:Color>
    <oscolor:Color x:Key="osTrayMenuEffect_DisColor">#A1A1A1A1</oscolor:Color>
    
    <!-- ** Effect Settings ** -->

    <sys:Double x:Key="osEffect_Thickness">1.2</sys:Double>
    <sys:Double x:Key="osEffect_Spread">6</sys:Double>
    <sys:Double x:Key="osEffect_Fade">0</sys:Double>
    <sys:Double x:Key="osEffect_Stroke">1</sys:Double>
    <sys:Double x:Key="osEffect_Glow">0.5</sys:Double>    
    <oscolor:Color x:Key="osEffect_Color">#A1421110</oscolor:Color>

    <!-- ** Button Settings ** -->
    
    <sys:Double x:Key="osBtn_Height">36</sys:Double>    
    <sys:Double x:Key="osBtn_FontSize">20</sys:Double>
    <FontWeight x:Key="osBtn_FontWeight">Bold</FontWeight>    
    <Thickness x:Key="osBtn_TextPadding">0,2,0,0</Thickness>
    <Thickness x:Key="osBtn_ContentPadding">0,2</Thickness>

    <!-- ** Visual Settings ** -->    

    <!-- [ Popup Timing ] -->

    <VisSettings:osVisConfig x:Key="PopupAni_OpenStart" visDur="0" />
    <VisSettings:osVisConfig x:Key="PopupAni_OpenDuration" visDur="225" />
    <VisSettings:osVisConfig x:Key="PopupAni_OpenDurationPrimary" visDur="550" />
    <VisSettings:osVisConfig x:Key="PopupAni_OpenDurationFade" visDur="375" />

    <VisSettings:osVisConfig x:Key="PopupAni_CloseStart" visDur="0" />
    <VisSettings:osVisConfig x:Key="PopupAni_CloseDuration" visDur="550" />
    <VisSettings:osVisConfig x:Key="PopupAni_CloseByBtnDuration" visDur="450" />
    <VisSettings:osVisConfig x:Key="PopupAni_CloseByBtnFadeDuration" visDur="450" />
    
    <!-- [ Popup Easings ] -->

    <VisSettings:osVisualEasing x:Key="PopupEase_OpenScale" visEasing="PopupOpen_Scale" />
    <VisSettings:osVisualEasing x:Key="PopupEase_OpenScalePrimary" visEasing="PopupOpen_ScalePrimary" />
    <VisSettings:osVisualEasing x:Key="PopupEase_OpenFade" visEasing="PopupOpen_Fade" />

    <VisSettings:osVisualEasing x:Key="PopupEase_Close" visEasing="PopupClose" />
    <VisSettings:osVisualEasing x:Key="PopupEase_CloseByBtn" visEasing="PopupClose_ByBtn" />
    <VisSettings:osVisualEasing x:Key="PopupEase_CloseByCmd" visEasing="PopupClose_ByCmd" />

    <!-- [ Popup Config ] -->

    <sys:Double x:Key="PopupAni_StartScale">0.00</sys:Double>
    <sys:Double x:Key="PopupAni_StartFade">0.0</sys:Double>
    
    <sys:Double x:Key="PopupAni_OpenScale">0.7</sys:Double>
    <sys:Double x:Key="PopupAni_Loaded">1.0</sys:Double>
    
    <sys:Double x:Key="PopupAni_CloseFade">0.0</sys:Double>
    <sys:Double x:Key="PopupAni_CloseScale">0.00</sys:Double>
    <sys:Double x:Key="PopupAni_CloseByBtnScale">25.0</sys:Double>

    <!-- [ Overlay Timing ] -->

    <VisSettings:osVisConfig x:Key="OverlayAni_OpenStart" visDur="0" />
    <VisSettings:osVisConfig x:Key="OverlayAni_OpenDuration" visDur="500" />
    
    <VisSettings:osVisConfig x:Key="OverlayAni_CloseStart" visDur="0" />
    <VisSettings:osVisConfig x:Key="OverlayAni_CloseDuration" visDur="500" />
    <VisSettings:osVisConfig x:Key="OverlayAni_CloseByBtnDuration" visDur="300" />

    <!-- [ Overlay Easings ] -->

    <VisSettings:osVisualEasing x:Key="OverlayEase_Open" visEasing="OverlayOpen" />
    
    <VisSettings:osVisualEasing x:Key="OverlayEase_Close" visEasing="OverlayClose" />
    <VisSettings:osVisualEasing x:Key="OverlayEase_CloseByBtn" visEasing="OverlayClose_ByBtn" />

    <!-- [ Overlay Config ] -->
    
    <sys:Double x:Key="OverlayAni_OpenFade">0.0</sys:Double>
    
    <sys:Double x:Key="OverlayAni_Loaded">0.7</sys:Double>
    
    <sys:Double x:Key="OverlayAni_CloseFade">0.0</sys:Double>

</ResourceDictionary>