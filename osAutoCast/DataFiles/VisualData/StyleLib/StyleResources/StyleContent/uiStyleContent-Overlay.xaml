<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="OverlayVisuals" TargetType="{x:Type Window}">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="CacheMode" Value="BitmapCache" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="LowQuality" />
        <Setter Property="RenderOptions.EdgeMode" Value="Aliased" />
        <Style.Resources>
            <Storyboard x:Key="OverlayVisual_Open">
                <DoubleAnimationUsingKeyFrames x:Name="visOpen_Overlay" Storyboard.TargetProperty="Opacity" FillBehavior="HoldEnd">
                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0" >
                        <EasingDoubleKeyFrame.EasingFunction>
                            <ExponentialEase EasingMode="EaseIn" Exponent="0.75" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:0.500" Value="1" >
                        <EasingDoubleKeyFrame.EasingFunction>
                            <ExponentialEase EasingMode="EaseIn" Exponent="0.75" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="OverlayVisual_Close">
                <DoubleAnimationUsingKeyFrames x:Name="visClose_Overlay" Storyboard.TargetProperty="Opacity" FillBehavior="HoldEnd">
                    <EasingDoubleKeyFrame KeyTime="{StaticResource OverlayAni_CloseStart}" Value="{StaticResource OverlayAni_Loaded}" EasingFunction="{StaticResource OverlayEase_Close}" />
                    <EasingDoubleKeyFrame KeyTime="{StaticResource OverlayAni_CloseDuration}" Value="{StaticResource OverlayAni_CloseFade}" EasingFunction="{StaticResource OverlayEase_Close}" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="OverlayVisual_CloseByCmd">
                <DoubleAnimationUsingKeyFrames x:Name="visCloseByCmd_Overlay" Storyboard.TargetProperty="Opacity" FillBehavior="HoldEnd">
                    <EasingDoubleKeyFrame KeyTime="{StaticResource OverlayAni_CloseStart}" Value="{StaticResource OverlayAni_Loaded}" EasingFunction="{StaticResource OverlayEase_Close}" />
                    <EasingDoubleKeyFrame KeyTime="{StaticResource OverlayAni_CloseDuration}" Value="{StaticResource OverlayAni_CloseFade}" EasingFunction="{StaticResource OverlayEase_Close}" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="OverlayVisual_CloseByBtn">
                <DoubleAnimationUsingKeyFrames x:Name="visCloseByBtn_Overlay" Storyboard.TargetProperty="Opacity" FillBehavior="HoldEnd">
                    <EasingDoubleKeyFrame KeyTime="{StaticResource OverlayAni_CloseStart}" Value="{StaticResource OverlayAni_Loaded}" EasingFunction="{StaticResource OverlayEase_CloseByBtn}" />
                    <EasingDoubleKeyFrame KeyTime="{StaticResource OverlayAni_CloseByBtnDuration}" Value="{StaticResource OverlayAni_CloseFade}" EasingFunction="{StaticResource OverlayEase_CloseByBtn}" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </Style.Resources>
    </Style>

</ResourceDictionary>