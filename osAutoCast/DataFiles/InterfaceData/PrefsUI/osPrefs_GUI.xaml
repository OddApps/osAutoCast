<osVis:VisAdapterUI x:Class="osPrefs_GUI" x:Name="winOpts" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:osAutoCast" 
                    xmlns:osVis="clr-namespace:osAutoCast.osVisualAdapter" xmlns:osCtrl="clr-namespace:osAutoCast.osControls"
                    xmlns:osPrefs="clr-namespace:osAutoCast.osPrefLib" Height="385" Topmost="True" mc:Ignorable="d" Title="Settings"
                    WindowStyle="None" WindowStartupLocation="CenterScreen" Style="{StaticResource osPrefsStyle}"
                    AllowsTransparency="True" ShowInTaskbar="False">

    <osVis:VisAdapterUI.Resources>
        <Storyboard x:Key="osPrefsVis_Disp" BeginTime="00:00:00" Duration="00:00:1.6">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="osPrefsOutlineRender"
										   Storyboard.TargetProperty="ScaleX" FillBehavior="HoldEnd">
				<EasingDoubleKeyFrame KeyTime="00:00:00" Value="0" />
                <EasingDoubleKeyFrame KeyTime="00:00:0.6" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
			<DoubleAnimationUsingKeyFrames Storyboard.TargetName="osPrefsExpandRender"
										   Storyboard.TargetProperty="ScaleY" FillBehavior="HoldEnd">
                <EasingDoubleKeyFrame KeyTime="00:00:0.80" Value="0" />
                <EasingDoubleKeyFrame KeyTime="00:00:1.6" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <local:osPrefExpandEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
           </DoubleAnimationUsingKeyFrames>
			<DoubleAnimationUsingKeyFrames Storyboard.TargetName="osPrefsTitlePanel"
										   Storyboard.TargetProperty="Opacity" FillBehavior="HoldEnd">
				<EasingDoubleKeyFrame KeyTime="00:00:1.45" Value="1" />
				<EasingDoubleKeyFrame KeyTime="00:00:1.6" Value="0" />
			</DoubleAnimationUsingKeyFrames>
		</Storyboard>
		
        <Storyboard x:Key="osPrefsVis_Close">
            <DoubleAnimation Storyboard.TargetName="osPrefsTitlePanel" 
                             Storyboard.TargetProperty="Opacity"
							 BeginTime="00:00:0.00" From="0" To="1"
							 Duration="00:00:0.550" FillBehavior="HoldEnd">
            </DoubleAnimation>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="osPrefsExpandRender"
                                           Storyboard.TargetProperty="ScaleY" FillBehavior="HoldEnd">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                <EasingDoubleKeyFrame KeyTime="00:00:0.750" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="osPrefsOutlineRender"
                                           Storyboard.TargetProperty="ScaleX" FillBehavior="HoldEnd">
                <EasingDoubleKeyFrame KeyTime="00:00:0.850" Value="1" />
                <EasingDoubleKeyFrame KeyTime="00:00:1.6" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </osVis:VisAdapterUI.Resources>

    <osVis:VisAdapterUI.DataContext>
        <osPrefs:osPreferenceLib PropertyChanged="osPreferenceLib_PropertyChanged"/>
    </osVis:VisAdapterUI.DataContext>

    <osCtrl:osBorder x:Name="osPrefsMainContainer" Opacity="1" Margin="0"
					 Style="{StaticResource osPrefsMainContainerStyle}" CornerRadius="12"
					 BorderBrush="#101010" ClipInflation="1" VerticalAlignment="Center">
        <osCtrl:osBorder.RenderTransform>
            <ScaleTransform x:Name="osPrefsOutlineRender"
							ScaleX="0.00" ScaleY="1" />
        </osCtrl:osBorder.RenderTransform>
		<Grid Background="#FF3C3C3C" x:Name="osPrefsContentContain">
			<Grid.RowDefinitions>
				<RowDefinition Height="36"/> 
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Border CornerRadius="0" BorderBrush="#FF1A1A1A"  Grid.Row="0"
					BorderThickness="0,0,0,2" Background="#FF282828" VerticalAlignment="Top" >
				<Grid x:Name="osPrefs_TitleBarContainer" ClipToBounds="True" Background="#FF282828"
					  MinHeight="36"  SnapsToDevicePixels="True" VerticalAlignment="Center">
					<Grid x:Name="osPrefs_TitleBar">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="24" />
						</Grid.ColumnDefinitions>
                        <Label Grid.Column="0">
                            <Label.Content>
                                <TextBlock Text="Options" FontSize="18" 
                                        LineStackingStrategy="MaxHeight" FontWeight="SemiBold" />
                            </Label.Content>
                        </Label>
                        <Button x:Name="osPrefsBtn_Close" Grid.Column="1"
                                Background="Transparent" Foreground="#FF000000"
                                Style="{StaticResource osPrefsBtnCloseStyle}" />
                    </Grid>
					<Border x:Name="osPrefsTitlePanel" Background="#FF282828" Height="36"
							VerticalAlignment="Center" Opacity="1">
                        <Label HorizontalContentAlignment="Center" Height="NaN"
                                VerticalContentAlignment="Center" Padding="0">
                            <Label.Content>
                                <TextBlock Text="osAutoCast" FontSize="24" TextAlignment="Center"
                                            local:TextBlockExtensions.CharacterSpacing="1.5"
                                            LineStackingStrategy="BlockLineHeight"
                                            LineHeight="30" FontWeight="Bold" />
                            </Label.Content>
                        </Label>
					</Border>                       
				</Grid>
			</Border>
			<Border Grid.Row="1" VerticalAlignment="Bottom" Height="283" RenderTransformOrigin="0.5,0">
								<Border.LayoutTransform>
						<ScaleTransform x:Name="osPrefsExpandRender" ScaleX="1" ScaleY="0" />
					</Border.LayoutTransform>
	<Grid x:Name="BottomContainer"
					  Background="#FF3C3C3C">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<osCtrl:osPanel HeaderText="AutoCast" HeaderColor="#FFC4C4C4" Grid.Row="0" 
                                         Margin="0,2,0,0" FontFamily="Trebuchet MS" FontSize="18" 
                                         FontWeight="Bold" Padding="6,0,6,6">
						<Grid x:Name="grid">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition/>
								<ColumnDefinition/>
							</Grid.ColumnDefinitions>
							<Label Content="Fuse" FontWeight="Normal" FontSize="16"				
									   HorizontalContentAlignment="Left" Grid.Column="0" 
                                       Padding="0" Grid.Row="0" VerticalAlignment="Center" 
                                       HorizontalAlignment="Left" />
							<osCtrl:osUpDownTextBox x:Name="osPrefsTxt_acFuse" Grid.Column="1"
														FontWeight="Normal" Grid.Row="0" Height="30" FontSize="16"
														VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
														Value="{Binding AutoCast_Fuse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
														UseLayoutRounding="True" Minimum="10" Maximum="1200" Increment="5" />
							<Grid Grid.Row="1" Grid.ColumnSpan="2" 
									  Grid.Column="0" Margin="0,4,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBlock Text="Release To Cast" FontSize="16" FontWeight="Regular"
											   VerticalAlignment="Top" />
								<CheckBox x:Name="osPrefsChk_acRTC" Grid.Column="1" IsChecked="{Binding AutoCast_RTC, Mode=TwoWay}" 
                                              VerticalAlignment="Bottom" VerticalContentAlignment="Center" />
							</Grid>
						</Grid>
					</osCtrl:osPanel>
					<osCtrl:osPanel HeaderText="AutoPass" HeaderColor="#FFC4C4C4" Margin="0,2,0,0" Grid.Row="1" 
                                         FontFamily="Trebuchet MS" FontSize="18" FontWeight="Bold" Padding="6,0,6,6">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition/>
								<ColumnDefinition/>
							</Grid.ColumnDefinitions>
							<Label Content="Safety Timer" FontWeight="Normal" Grid.Column="0" 
								   Padding="0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16" />
							<osCtrl:osUpDownTextBox x:Name="osPrefsTxt_apSafetyTimer" TextWrapping="NoWrap"
													Grid.Column="1" Height="30" VerticalContentAlignment="Center"
													FontSize="16" FontWeight="Regular" HorizontalContentAlignment="Center"
													Value="{Binding AutoPass_SafetyTimer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
													Minimum="100" Maximum="3000" Increment="5" />
						</Grid>
					</osCtrl:osPanel>
					<osCtrl:osPanel HeaderText="General" HeaderColor="#FFC4C4C4" Margin="0,2,0,0" Grid.Row="2" 
                                         FontFamily="Trebuchet MS" FontSize="18" FontWeight="Bold" Padding="6,0,6,6">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition/>
								<ColumnDefinition/>
							</Grid.ColumnDefinitions>
							<Label Content="Visual Quality" FontWeight="Normal" Grid.Column="0" 
								   Padding="0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="16" />
							<ComboBox x:Name="osPrefslst_VQ" Grid.Column="1" Style="{StaticResource osPrefsVisQ_DropDownStyle}" 
									  ItemsSource="{Binding vqList}" IsEditable="False" SelectedValue="{Binding GenOpts_VisualQuality}"
									  DisplayMemberPath="vqN" Height="30" FontSize="14" FontWeight="Normal" Foreground="#FFFFFFFF"
									  SelectedValuePath="vqID" Background="#FF575757" OverridesDefaultStyle="True" />
						</Grid>
					</osCtrl:osPanel>
					<Button x:Name="osPrefsBtn_Save" Content="Save" Style="{StaticResource osPrefsSaveBtnStyle}"
							Margin="8,6,8,6" FontSize="18" Padding="0,8" Grid.Row="3" Height="44"
							IsEnabled="{Binding IsSaveEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
							FontWeight="Bold" FontFamily="Segoe UI" />
				</Grid>
			</Border>
			<!--<Grid Grid.Row="0" Grid.RowSpan="2" Background="#6A0A0A0A"></Grid>-->
		</Grid>
	</osCtrl:osBorder>

</osVis:VisAdapterUI>