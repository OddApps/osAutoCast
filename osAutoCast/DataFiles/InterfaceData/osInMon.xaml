<Window x:Class="osInMon" Name="osInMon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:osAutoCast"
        mc:Ignorable="d"
        Title="osAutoCast v1.0 | By OddSoft"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None" Height="600"
        BorderBrush="#BF9E1A1A" BorderThickness="4"
		VerticalAlignment="Top" Background="{x:Null}"
		HorizontalAlignment="Center" Width="585">
    <Grid Background="#FF100D0B">
        <Image Height="576" Width="576" Source="pack://siteoforigin:,,,/Resources/osSplashLoader.png" VerticalAlignment="Top" HorizontalAlignment="Center"/>
        <Border x:Name="LoadContentContainer" VerticalAlignment="Bottom"
                Margin="30,0,30,10"
                Padding="14,2,14,0"
                Background="#4C323232"
                CornerRadius="8" BorderBrush="#FF646464" BorderThickness="2">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0">
                <TextBlock x:Name="lblLoadContent" Text="Loading"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,2" Padding="0,2,0,4"
                           local:TextBlockExtensions.CharacterSpacing="2" Height="34" ScrollViewer.VerticalScrollBarVisibility="Disabled" Width="{Binding ActualWidth, ElementName=LoadContentContainer, Mode=OneWay}" UseLayoutRounding="True">
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0" Height="26">
                    <TextBlock x:Name="Dot1" FontSize="32" FontWeight="Bold" Opacity="0.25" Margin="1,0" Padding="1,2,1,0" VerticalAlignment="Bottom" Height="44">
                        <Run BaselineAlignment="Center" FontSize="32">•</Run>
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="White"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock x:Name="Dot2" FontSize="32" FontWeight="Bold" Opacity="0.25" Margin="1,0" Padding="1,2,1,0" VerticalAlignment="Bottom" Height="44">
                        <Run BaselineAlignment="Center" FontSize="32">•</Run>
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="White"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock x:Name="Dot3" FontSize="32" FontWeight="Bold" Opacity="0.25" Margin="1,0" Padding="1,2,1,0" VerticalAlignment="Bottom" Height="44">
                        <Run BaselineAlignment="Center" FontSize="32">•</Run>
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="White"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1"
                                                       Storyboard.TargetProperty="Opacity"
                                                       Duration="0:0:1.2" RepeatBehavior="Forever">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="0.25"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="0.25"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1.0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Dot1"
                                                      Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                      Duration="0:0:1.2" RepeatBehavior="Forever">
                            <DiscreteColorKeyFrame KeyTime="0:0:0.0" Value="#FF5F1212"/>
                            <DiscreteColorKeyFrame KeyTime="0:0:0.4" Value="White"/>
                            <DiscreteColorKeyFrame KeyTime="0:0:0.8" Value="White"/>
                            <DiscreteColorKeyFrame KeyTime="0:0:1.2" Value="#FF5F1212"/>
                        </ColorAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2"
                                                       Storyboard.TargetProperty="Opacity"
                                                       Duration="0:0:1.2" RepeatBehavior="Forever">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.25"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="1.0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="0.25"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0.25"/>
                        </DoubleAnimationUsingKeyFrames>
                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Dot2"
                                                      Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                      Duration="0:0:1.2" RepeatBehavior="Forever">
                            <DiscreteColorKeyFrame KeyTime="0:0:0.0" Value="White"/>
                            <DiscreteColorKeyFrame KeyTime="0:0:0.4" Value="#FF5F1212"/>
                            <DiscreteColorKeyFrame KeyTime="0:0:0.8" Value="White"/>
                            <DiscreteColorKeyFrame KeyTime="0:0:1.2" Value="White"/>
                        </ColorAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3"
                                                       Storyboard.TargetProperty="Opacity"
                                                       Duration="0:0:1.2" RepeatBehavior="Forever">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.25"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="0.25"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="1.0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0.25"/>
                        </DoubleAnimationUsingKeyFrames>
                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Dot3"
                                                      Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                      Duration="0:0:1.2" RepeatBehavior="Forever">
                            <DiscreteColorKeyFrame KeyTime="0:0:0.0" Value="White"/>
                            <DiscreteColorKeyFrame KeyTime="0:0:0.4" Value="White"/>
                            <DiscreteColorKeyFrame KeyTime="0:0:0.8" Value="#FF5F1212"/>
                            <DiscreteColorKeyFrame KeyTime="0:0:1.2" Value="White"/>
                        </ColorAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
    </Grid>
</Window>
