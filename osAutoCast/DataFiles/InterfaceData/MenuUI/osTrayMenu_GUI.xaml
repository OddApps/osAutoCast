<osVis:VisAdapterUI x:Class="osTrayMenu_GUI" x:Name="winTrayMenu" Title="osPopupMenu_GUI" mc:Ignorable="d"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Background="Transparent" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsTabStop="False" AllowsTransparency="True"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" UseLayoutRounding="True"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Topmost="True" WindowStyle="None"
        ShowActivated="True" WindowStartupLocation="Manual" Focusable="True" SizeToContent="Height"
        ShowInTaskbar="False" DataContext="{Binding RelativeSource={RelativeSource Self}}" 
        xmlns:osVis="clr-namespace:osAutoCast.osVisualAdapter" Style="{StaticResource TrayMenuStyle}">
    
    <osVis:VisAdapterUI.Resources>
      <Storyboard x:Key="TrayMenuVis_Display">
    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrayMenuOutlineRender"
                                   Storyboard.TargetProperty="ScaleX"
                                   FillBehavior="HoldEnd">
        <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0" />
        <EasingDoubleKeyFrame KeyTime="00:00:00.450" Value="1">
            <EasingDoubleKeyFrame.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut" />
            </EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
    </DoubleAnimationUsingKeyFrames>

    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrayMenuOutlineRender"
                                   Storyboard.TargetProperty="ScaleY"
                                   FillBehavior="HoldEnd">
        <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0" />
        <EasingDoubleKeyFrame KeyTime="00:00:00.450" Value="1">
            <EasingDoubleKeyFrame.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut" />
            </EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
    </DoubleAnimationUsingKeyFrames>

    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrayMenuOutline"
                                   Storyboard.TargetProperty="(UIElement.Opacity)"
                                   FillBehavior="HoldEnd">
        <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0" />
        <EasingDoubleKeyFrame KeyTime="00:00:00.450" Value="1">
            <EasingDoubleKeyFrame.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut" />
            </EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
    </DoubleAnimationUsingKeyFrames>
</Storyboard>

<Storyboard x:Key="TrayMenuVis_Close">
    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrayMenuOutlineRender"
                                   Storyboard.TargetProperty="ScaleX"
                                   FillBehavior="HoldEnd">
        <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1" />
        <EasingDoubleKeyFrame KeyTime="00:00:00.575" Value="0">
            <EasingDoubleKeyFrame.EasingFunction>
                <!-- start slower so it's not snappy -->
                    <QuadraticEase EasingMode="EaseInOut" />
            </EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
    </DoubleAnimationUsingKeyFrames>

    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrayMenuOutlineRender"
                                   Storyboard.TargetProperty="ScaleY"
                                   FillBehavior="HoldEnd">
        <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1" />
        <EasingDoubleKeyFrame KeyTime="00:00:00.575" Value="0">
            <EasingDoubleKeyFrame.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut" />
            </EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
    </DoubleAnimationUsingKeyFrames>

    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrayMenuOutline"
                                   Storyboard.TargetProperty="(UIElement.Opacity)"
                                   FillBehavior="HoldEnd">
        <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1" />
        <EasingDoubleKeyFrame KeyTime="00:00:00.575" Value="0">
            <EasingDoubleKeyFrame.EasingFunction>
                <!-- opacity leads/smooths out the perceived timing -->
                    <QuadraticEase EasingMode="EaseInOut" />
            </EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
    </DoubleAnimationUsingKeyFrames>
</Storyboard>


