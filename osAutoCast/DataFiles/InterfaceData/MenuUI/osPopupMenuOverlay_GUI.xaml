<osVis:VisAdapterUI x:Class="osPopupMenuOverlay_GUI" x:Name="winPopupMenuOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:osVis="clr-namespace:osAutoCast.osVisualAdapter"
					ShowActivated="False" Topmost="True" Focusable="False" ShowInTaskbar="False" ResizeMode="NoResize" Background="Transparent"
                    mc:Ignorable="d" Title="" WindowStartupLocation="Manual" WindowStyle="None" AllowsTransparency="True" Opacity="1"
                    Width="{x:Static SystemParameters.VirtualScreenWidth}" Height="{x:Static SystemParameters.VirtualScreenHeight}"
                    Left="{x:Static SystemParameters.VirtualScreenLeft}" Top="{x:Static SystemParameters.VirtualScreenTop}">
    
    <osVis:VisAdapterUI.Resources>
        <Storyboard x:Key="OverlayVisual_Open">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OverlayBackground"
                                            Storyboard.TargetProperty="Opacity" FillBehavior="HoldEnd">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0" />
                <EasingDoubleKeyFrame KeyTime="00:00:0.500" Value="0.7" >
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="OverlayVisual_Close">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OverlayBackground"
                                            Storyboard.TargetProperty="Opacity" FillBehavior="HoldEnd">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0.7" />
                <EasingDoubleKeyFrame KeyTime="00:00:0.500" Value="0" >
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="OverlayVisual_CloseByCmd">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OverlayBackground"
                                            Storyboard.TargetProperty="Opacity" FillBehavior="HoldEnd">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0.7" />
                <EasingDoubleKeyFrame KeyTime="00:00:0.500" Value="0" >
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="OverlayVisual_CloseByBtn">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OverlayBackground"
                                            Storyboard.TargetProperty="Opacity" FillBehavior="HoldEnd">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0.7" />
                <EasingDoubleKeyFrame KeyTime="00:00:0.300" Value="0" >
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </osVis:VisAdapterUI.Resources>
    
        <Rectangle x:Name="OverlayBackground" Fill="#FF000000" Opacity="0.0"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"
                   RenderOptions.EdgeMode="Aliased" SnapsToDevicePixels="True" UseLayoutRounding="True"/>

</osVis:VisAdapterUI>