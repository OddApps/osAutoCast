<Window x:Class="osPopupMenu_GUI" x:Name="winPopupMenu" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:osStyle="clr-namespace:osAutoCast.osStyle"
        Topmost="True" Background="Transparent" mc:Ignorable="d" Title="osPopupMenu_GUI" WindowStartupLocation="CenterScreen"
        ShowActivated="False" IsTabStop="False" Focusable="False" WindowStyle="None" ShowInTaskbar="False" AllowsTransparency="True"
        DataContext="{Binding RelativeSource={RelativeSource Self}}" Style="{StaticResource MainContentContainerStyle}">

    <Border x:Name="popupMainContainer" CacheMode="BitmapCache" 
            RenderOptions.BitmapScalingMode="LowQuality"
            osStyle:osPopupScale.PopupScale="0.01"
            Style="{StaticResource MainContainerStyle}">
        <Grid x:Name="popupContentContainer" Style="{StaticResource ContentContainerStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="pmChk_IsEnabled" Grid.Row="0" Grid.Column="0"
                          IsChecked="{Binding IsAppEnabled, Mode=TwoWay, ElementName=winPopupMenu}"
                          Style="{StaticResource pmBtnEnabledStatusStyle}" />
            <StackPanel x:Name="stackPanel" Grid.Row="1" Grid.Column="0" 
                        DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                <ToggleButton x:Name="btnShowGameMenu" Content="Game Menu" 
                              Style="{StaticResource pmBtnGameMenuStyle}" IsChecked="False" />
                <Border x:Name="GameMenuPanel" Style="{StaticResource HideShowGameMenu}">
                    <StackPanel>
                        <Button x:Name="pmBtn_StartGame" Content="Start MTGA"
                                Style="{StaticResource GameMenu_ShowStart}" />
                        <Button x:Name="pmBtn_CloseGame" Content="Close MTGA"
                                Style="{StaticResource GameMenu_ShowClose}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button x:Name="pmBtn_ShowOptions" Content="Options" Grid.Row="2"
                    Grid.Column="0" Style="{StaticResource pmBtnMainStyle}" />
            <Button x:Name="pmBtn_Exit" Content="Exit" Grid.Row="3"
                    Grid.Column="0" Style="{StaticResource pmBtnBrdrStyle}" />
        </Grid>
    </Border>

</Window>