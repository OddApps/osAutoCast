<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:osStyle="clr-namespace:osAutoCast.osStyle">

    <Style x:Key="HideShowGameMenu" BasedOn="{StaticResource StyleBase_Border}" 
           TargetType="{x:Type Border}">
        <Setter Property="MaxHeight" Value="0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="ClipToBounds" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked,
                ElementName=btnShowGameMenu}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="GameMenuExpand">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" 
                                                        Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight" From="0"
                                             To="{StaticResource osBtn_Height}" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0"
                                             To="1" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="GameMenuExpand" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsChecked,
                ElementName=btnShowGameMenu}" Value="False">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="GameMenuCollapse">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight" From="{StaticResource osBtn_Height}"
                                             To="0" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1"
                                             To="0" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.49"
                                                        Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="GameMenuCollapse" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="MainContainerStyle" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="#FF521212" />
        <Setter Property="Background" Value="#FF1F1F1F" />
        <Setter Property="BorderThickness" Value="4,4,4,4" />
        <Setter Property="CornerRadius" Value="8,8,8,8" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="MaxWidth" Value="265" />
        <Setter Property="MaxHeight" Value="150" />
        <!--<Setter Property="MinWidth" Value="265" />-->
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="osStyle:osPopupScale.PopupScale" Value="0.00"/>
        <Style.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/DataFiles/StyleData/osUI_StyleVisuals.xaml"  />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Style.Resources>
    </Style>

</ResourceDictionary>

    