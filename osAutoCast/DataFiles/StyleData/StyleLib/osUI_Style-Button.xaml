<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gamemenuopts="clr-namespace:osAutoCast.GameMenuOpts"
                    xmlns:oseffect="clr-namespace:osAutoCast.osEffectConv"
                    xmlns:osStyle="clr-namespace:osAutoCast.osStyle">

    <oseffect:TexelSizeConverter x:Key="TexelSizeConverter" />

    <Style x:Key="pmBtnGameMenuItemStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource StyleBase_Btn}">
        <Setter Property="Background" Value="#A1101010" />
        <Setter Property="osStyle:osStyles.CornerRadius" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderThickness" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderBrush" Value="#FF222222"/>
        <Setter Property="osStyle:osStyles.Background" Value="#A1575757"/>
    </Style>
    
    <Style x:Key="GameMenu_ShowStart" TargetType="{x:Type Button}"
           BasedOn="{StaticResource pmBtnGameMenuItemStyle}">
        <Setter Property="osStyle:osStyles.CornerRadius" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderThickness" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderBrush" Value="#FF222222"/>
        <Setter Property="osStyle:osStyles.Background" Value="#C4363636"/>
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DisplayGameMenuItem}"
                         Value="{x:Static gamemenuopts:GameMenuItem.ShowStart}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="GameMenu_ShowClose" TargetType="{x:Type Button}"
           BasedOn="{StaticResource pmBtnGameMenuItemStyle}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="osStyle:osStyles.CornerRadius" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderThickness" Value="0,2"/>
        <Setter Property="osStyle:osStyles.BorderBrush" Value="#FF222222"/>
        <Setter Property="osStyle:osStyles.Background" Value="#C4363636"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DisplayGameMenuItem}"
                         Value="{x:Static gamemenuopts:GameMenuItem.ShowClose}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="pmBtnMainStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource StyleBase_Btn}">
        <Setter Property="osStyle:osStyles.CornerRadius" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderThickness" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderBrush" Value="#FF2B2828"/>
        <Setter Property="osStyle:osStyles.Background" Value="#A1575757"/>
    </Style>

    <Style x:Key="pmBtnBrdrStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource StyleBase_Btn}">
        <Setter Property="osStyle:osStyles.CornerRadius" Value="0,0,8,8"/>
        <Setter Property="osStyle:osStyles.BorderThickness" Value="0,0,0,0"/>
        <Setter Property="osStyle:osStyles.BorderBrush" Value="#FF222222"/>
        <Setter Property="osStyle:osStyles.Background" Value="#A1575757"/>
    </Style>
    
</ResourceDictionary>