<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gamemenuopts="clr-namespace:osAutoCast.GameMenuOpts">
    <Style x:Key="pmBtnGameMenuItemStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#E5020202" />
        <Setter Property="Foreground" Value="#FF8C8A8A" />
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Width" Value="{Binding ActualWidth,
            ElementName=pmMenuItemContainer, Mode=OneWay}" />
        <Setter Property="Padding" Value="0,0,0,0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="BorderBrush" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#FF2B2828"
                                BorderThickness="0,0,0,0" Height="34">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" Height="32" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#A1575757" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GameMenu_ShowStart" TargetType="{x:Type Button}"
           BasedOn="{StaticResource pmBtnGameMenuItemStyle}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#FF2B2828"
                                BorderThickness="0,0,0,0" Height="34">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" Height="32" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#A1575757" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DisplayGameMenuItem}"
                         Value="{x:Static gamemenuopts:GameMenuItem.ShowStart}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="GameMenu_ShowClose" TargetType="{x:Type Button}"
           BasedOn="{StaticResource pmBtnGameMenuItemStyle}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#FF2B2828"
                                BorderThickness="0,0,0,0" Height="34">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Height="32" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#A1575757" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DisplayGameMenuItem}"
                         Value="{x:Static gamemenuopts:GameMenuItem.ShowClose}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="pmBtnMainStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FF8C8A8A" />
        <Setter Property="Height" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Width" Value="{Binding ActualWidth,
            ElementName=pmMenuItemContainer, Mode=OneWay}" />
        <Setter Property="Padding" Value="0,0,0,0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="BorderBrush" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#FF2B2828"
                                Width="{Binding ActualWidth, ElementName=pmMenuItemContainer, Mode=OneWay}"
                                BorderThickness="0,0,0,0" Height="34" CornerRadius="0,0,8,8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Stretch" Height="32" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#A1575757" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="pmBtnBrdrStyle" BasedOn="{StaticResource pmBtnMainStyle}"
           TargetType="{x:Type Button}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Width" Value="{Binding ActualWidth,
            ElementName=pmMenuItemContainer, Mode=OneWay}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#FF222222"
                                BorderThickness="0,0,0,2" Height="36" CornerRadius="0,0,0,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Height="32" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#A1575757" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>