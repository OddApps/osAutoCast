<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:oseffect="clr-namespace:osAutoCast.osEffectConv"
                    xmlns:osStyle="clr-namespace:osAutoCast.osStyle"
                    xmlns:local="clr-namespace:osAutoCast">

    <oseffect:TexelSizeConverter x:Key="TexelSizeConverter" />

    <ControlTemplate x:Key="ToggleView_EnabledStatus" TargetType="{x:Type ToggleButton}">
        <Border x:Name="enView_Border" Background="{TemplateBinding Background}" Height="36"
                Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Width}" VerticalAlignment="Stretch"
                CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.CornerRadius)}"
                BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.BorderThickness)}"
                BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.BorderBrush)}" Padding="0,0,0,0">
            <ContentPresenter HorizontalAlignment="Center" x:Name="toggleContent" ClipToBounds="False" 
                              ContentTemplate="{StaticResource osEffectTextToggle}" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="enView_Border" Property="Background"
                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.Background)}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="False">
                <Setter Property="Content" Value="Disabled" />
                <Setter Property="Background" Value="#A10F0F0F" />
                <Setter Property="Foreground" Value="#FF373636" />
                <Setter TargetName="toggleContent" Property="Effect">
                    <Setter.Value>
                        <BlurEffect Radius="4" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="Enabled" />
                <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Background}" />
                <Setter Property="Foreground" Value="#FF8C8A8A" />
                <Setter TargetName="toggleContent" Property="Effect" Value="{x:Null}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="ToggleView_GameMenu" TargetType="{x:Type ToggleButton}">
        <Border x:Name="enBorderGameMnu" Background="{TemplateBinding Background}" Height="36"
                Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Width}"
                CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.CornerRadius)}"
                BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.BorderThickness)}"
                BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.BorderBrush)}" VerticalAlignment="Stretch">
            <ContentPresenter HorizontalAlignment="Center" x:Name="toggleContent" ClipToBounds="False" 
                              ContentTemplate="{StaticResource osEffectTextToggle}" VerticalAlignment="Center" Margin="0,0,0,2" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="enBorderGameMnu" Property="Background"
                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(osStyle:osStyles.Background)}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>
