<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:oscolor="clr-namespace:System.Windows.Media;assembly=PresentationCore">
    <sys:Double x:Key="osEffect_Thickness">2.5</sys:Double>
    <sys:Double x:Key="osEffect_Spread">3</sys:Double>
    <sys:Double x:Key="osEffect_Fade">0</sys:Double>
    <sys:Double x:Key="osEffect_Stroke">1.50</sys:Double>
    <sys:Double x:Key="osEffect_Glow">1.1</sys:Double>
    <oscolor:Color x:Key="osEffect_Color">#CC421110</oscolor:Color>
</ResourceDictionary>