<Window x:Class="osInMon" Name="osInMon" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Topmost="True"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:osLoadProg="clr-namespace:osAutoCast.osLoadingElements" mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="osAutoCast v1.0 | By OddSoft"
        ResizeMode="NoResize" AllowsTransparency="True" WindowStyle="None" Style="{StaticResource LoadingContainerStyle}">
   
    <Border Style="{StaticResource LoadingContentStyle}">
        <Grid Background="{StaticResource osLoadScreen_BgColor}" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Image Grid.Column="0" Grid.Row="0" Height="576" Width="576"
                   Style="{StaticResource LoadingImageStyle}" />
            <Border x:Name="LoadContentContainer" Background="#42323232"
                    Style="{StaticResource LoadingContentContainerStyle}">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0">
                    <TextBlock x:Name="LoadingText" Style="{StaticResource LoadingTextStyle}"
                               LineStackingStrategy="BlockLineHeight" LineHeight="32" Margin="0,4,0,2"/>
                    <osLoadProg:osLoadingProgressBar x:Name="LoadingProgressBar" Height="30" Minimum="0" Maximum="250"
                                                     TrackCornerRadius="0,0,6,6" FillCornerRadius="0,0,6,6"
                                                     RenderOptions.BitmapScalingMode="HighQuality" CacheMode="BitmapCache"
                                                     FillBrush="#FF5F1212" TrackBrush="#A1242424" Margin="0,4,0,0" />
                </StackPanel>
            </Border>            
        </Grid>
    </Border>
    
</Window>